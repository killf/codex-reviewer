  "version": "0.3.9",
  "author": { "name": "killf", "url": "https://github.com/killf" },
  "license": "MIT",
  "repository": "https://github.com/killf/codex-reviewer",
  "description": "Review local Git changes with a side-by-side diff in Codex.",
  "extensions": {
    "com.openai": {
      "interface": {
